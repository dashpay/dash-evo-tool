{
  "permissions": {
    "allow": [
      "Bash(.claude/skills/visual-diff/scripts/type-secret.sh *)"
    ],
    "ask": [
      "Edit(.claude/skills/visual-diff/scripts/**)"
    ],
    "deny": [
      "Edit(scripts/**)",
      "Write(scripts/**)",
      "Edit(.github/workflows/**)",
      "Write(.github/workflows/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
